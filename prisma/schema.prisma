// dao-ops — schema completo: auth + dominio de PCP / producción.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// Auth
// =============================================================================

enum Role {
  OPERARIO
  SUPERVISOR
  ADMIN
}

/// Usuario de la planta. Operario => login con PIN. Supervisor/Admin =>
/// login con username + password (también pueden tener PIN si operan también
/// desde la tablet).
model User {
  id             String    @id @default(cuid())
  name           String
  /// Username para supervisor/admin. Operarios pueden tenerlo null.
  username       String?   @unique
  /// bcrypt hash del PIN (operarios).
  pinHash        String?
  /// bcrypt hash del password (supervisor/admin).
  passwordHash   String?
  role           Role      @default(OPERARIO)
  isActive       Boolean   @default(true)
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  sessions      Session[]
  pcpsCreados   Pcp[]            @relation("PcpCreador")
  importaciones ImportacionCsv[]

  @@index([isActive])
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  token      String   @unique
  expiresAt  DateTime
  userAgent  String?
  ip         String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AuthEvent {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  ip        String?
  userAgent String?
  details   Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

// =============================================================================
// Catálogo: clientes, artículos
// =============================================================================

model Cliente {
  id        String   @id @default(cuid())
  nombre    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  articulos Articulo[]

  @@index([nombre])
}

/// Artículo del catálogo. Vienen del CSV (columnas B, C, D, J).
/// `color` se extrae del nombre por el parser; si no matchea, queda como
/// "Sin color / Revisar" y `colorRevisar = true`.
model Articulo {
  id            String   @id @default(cuid())
  /// Columna B del CSV — nombre/código del artículo. Único dentro de un cliente.
  codigo        String
  clienteId     String
  /// Columna D — descripción libre.
  descripcion   String?
  /// Columna J — piezas por hora de pintura.
  piezasPorHora Float
  /// Color extraído del nombre, o "Sin color / Revisar".
  color         String
  /// true si el parser no detectó color y el admin todavía no lo corrigió.
  colorRevisar  Boolean  @default(false)
  /// Configuración de perchas/gancheras (string libre). Si cambia entre dos
  /// ítems consecutivos en el PCP, se computa un cambio de perchas (45 min).
  configPerchas String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  cliente Cliente @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  items   Item[]

  @@unique([clienteId, codigo])
  @@index([color])
  @@index([colorRevisar])
}

// =============================================================================
// PCP (Plan / orden de trabajo de jornada)
// =============================================================================

enum Jornada {
  J_06_14
  J_14_22
  J_22_06
  J_06_18
  J_18_06
}

enum PcpEstado {
  PENDIENTE
  EN_CURSO
  FINALIZADO
  CANCELADO
}

enum ItemEstado {
  PENDIENTE
  EN_CURSO
  FINALIZADO
}

model Pcp {
  id          String    @id @default(cuid())
  /// Fecha y hora de inicio de la jornada (inicio del primer ítem).
  inicio      DateTime
  jornada     Jornada
  estado      PcpEstado @default(PENDIENTE)
  creadoPorId String
  /// Si el supervisor reordenó manualmente, true → el sistema no vuelve a
  /// re-optimizar. Si false, el orden propuesto está activo.
  ordenManual Boolean   @default(false)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  creadoPor User   @relation("PcpCreador", fields: [creadoPorId], references: [id])
  items     Item[]

  @@index([inicio])
  @@index([estado])
}

model Item {
  id              String     @id @default(cuid())
  pcpId           String
  articuloId      String
  /// Color resuelto al cargar el ítem. Puede coincidir o no con Articulo.color
  /// si el supervisor lo cambió manualmente.
  color           String
  cantidad        Int
  incluyeLavado   Boolean    @default(true)
  /// 1..10. Null si no incluye lavado.
  piezasPorPercha Int?
  /// 0.1..3.0 m/s. Null si no incluye lavado.
  velocidadLavado Float?
  /// Snapshot de la config de perchas del Articulo en el momento del PCP,
  /// para que cambios posteriores al maestro no afecten cálculos pasados.
  configPerchas   String?
  /// Posición del ítem en el PCP (0-based). Único dentro del PCP.
  orden           Int
  estado          ItemEstado @default(PENDIENTE)
  /// Tiempos teóricos del plan (recalculados al editar/reordenar el PCP).
  inicioTeorico   DateTime
  finTeorico      DateTime
  /// Tiempos reales (se llenan cuando el operario inicia / finaliza).
  inicioReal      DateTime?
  finReal         DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  pcp      Pcp      @relation(fields: [pcpId], references: [id], onDelete: Cascade)
  articulo Articulo @relation(fields: [articuloId], references: [id])
  pausas   Pausa[]

  @@unique([pcpId, orden])
  @@index([pcpId])
  @@index([estado])
}

/// Cada vez que un operario pausa un ítem se crea una Pausa con motivo libre.
/// Al reanudar, se setea `fin`. La duración total de pausas suma al tiempo real.
model Pausa {
  id        String    @id @default(cuid())
  itemId    String
  motivo    String
  inicio    DateTime  @default(now())
  fin       DateTime?
  createdAt DateTime  @default(now())

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([itemId])
}

// =============================================================================
// Importación CSV (audit)
// =============================================================================

model ImportacionCsv {
  id                    String   @id @default(cuid())
  usuarioId             String
  /// Nombre original del archivo subido.
  nombreArchivo         String?
  totalFilas            Int
  filasOk               Int
  filasError            Int
  articulosNuevos       Int      @default(0)
  articulosActualizados Int      @default(0)
  articulosSinColor     Int      @default(0)
  /// JSON con detalles: errores por fila, etc.
  detalle               Json?
  createdAt             DateTime @default(now())

  usuario User @relation(fields: [usuarioId], references: [id])

  @@index([createdAt])
}
