// dao-ops — schema: auth + dominio de Órdenes de Trabajo + Turnos.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// =============================================================================
// Auth
// =============================================================================

enum Role {
  OPERARIO
  SUPERVISOR
  ADMIN
}

/// Usuario de la planta. Operario => login con PIN. Supervisor/Admin =>
/// login con username + password (también pueden tener PIN si operan también
/// desde la tablet).
model User {
  id             String    @id @default(cuid())
  name           String
  /// Username para supervisor/admin. Operarios pueden tenerlo null.
  username       String?   @unique
  /// bcrypt hash del PIN (operarios).
  pinHash        String?
  /// bcrypt hash del password (supervisor/admin).
  passwordHash   String?
  role           Role      @default(OPERARIO)
  isActive       Boolean   @default(true)
  failedAttempts Int       @default(0)
  lockedUntil    DateTime?
  lastLoginAt    DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  sessions       Session[]
  ordenesCreadas OrdenTrabajo[]   @relation("OrdenCreador")
  importaciones  ImportacionCsv[]

  @@index([isActive])
}

model Session {
  id         String   @id @default(cuid())
  userId     String
  token      String   @unique
  expiresAt  DateTime
  userAgent  String?
  ip         String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
}

model AuthEvent {
  id        String   @id @default(cuid())
  userId    String?
  action    String
  ip        String?
  userAgent String?
  details   Json?
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([action])
  @@index([createdAt])
}

// =============================================================================
// Catálogo: clientes, artículos
// =============================================================================

model Cliente {
  id        String   @id @default(cuid())
  nombre    String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  articulos Articulo[]

  @@index([nombre])
}

/// Artículo del catálogo. Vienen del CSV.
/// `color` se extrae del nombre por el parser; si no matchea, queda como
/// "Sin color / Revisar" y `colorRevisar = true`.
model Articulo {
  id            String   @id @default(cuid())
  /// Columna A del CSV — nombre/código del artículo. Único dentro de un cliente.
  codigo        String
  clienteId     String
  /// Columna C — descripción libre.
  descripcion   String?
  /// Columna D — superficie de la pieza en m² (para reportes de m² pintados).
  superficieM2  Float?
  /// Columna I — piezas por hora de pintura.
  piezasPorHora Float
  /// Color extraído del nombre, o "Sin color / Revisar".
  color         String
  /// true si el parser no detectó color y el admin todavía no lo corrigió.
  colorRevisar  Boolean  @default(false)
  /// Configuración de perchas/gancheras (string libre). Si cambia entre dos
  /// OTs PINTURA consecutivos, se computa un cambio de perchas (45 min).
  configPerchas String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  cliente Cliente        @relation(fields: [clienteId], references: [id], onDelete: Cascade)
  ordenes OrdenTrabajo[]

  @@unique([clienteId, codigo])
  @@index([color])
  @@index([colorRevisar])
}

// =============================================================================
// Órdenes de trabajo
// =============================================================================

enum OrdenEstado {
  PENDIENTE
  EN_CURSO
  FINALIZADO
  CANCELADO
}

enum ItemTipo {
  LAVADO
  PINTURA
}

/// Una Orden de Trabajo (OT) = 1 artículo + cantidad + tipo (LAVADO o PINTURA)
/// con su horario de inicio elegido por el supervisor. Antes existía un modelo
/// agrupador "PCP" con sub-ítems; se eliminó. Ahora cada OT es independiente.
model OrdenTrabajo {
  id                 String      @id @default(cuid())
  /// Número correlativo humano-friendly (1, 2, 3…) para referenciar la OT.
  numero             Int         @unique @default(autoincrement())
  articuloId         String
  tipo               ItemTipo
  /// Color resuelto al cargar la OT. En LAVADO no se usa.
  color              String
  cantidad           Int
  /// Solo aplica a LAVADO.
  piezasPorPercha    Int?
  /// Solo aplica a LAVADO. Rango 0.1..3.0 m/s.
  velocidadLavado    Float?
  /// Snapshot de configPerchas del Articulo al crear la OT (para no perder
  /// trazabilidad si después se edita el maestro).
  configPerchas      String?
  estado             OrdenEstado @default(PENDIENTE)
  /// Horario de inicio elegido por el supervisor al cargar la OT.
  inicioProgramado   DateTime
  /// Plan teórico (puede recalcularse en cualquier finalización).
  inicioTeorico      DateTime
  finTeorico         DateTime
  /// Tiempos reales (se llenan en iniciar/finalizar).
  inicioReal         DateTime?
  finReal            DateTime?
  /// Si esta OT es la "continuación" de una que se partió por no entrar en el
  /// turno, apunta a la OT padre. La cantidad acá representa lo que queda por
  /// hacer; la padre conserva la cantidad original (con su estado FINALIZADO
  /// y cantidadCompletada = cantidad - resto).
  ordenPadreId       String?
  /// Cantidad efectivamente trabajada (útil cuando la OT se cierra parcialmente
  /// por fin de turno y se genera una continuación).
  cantidadCompletada Int         @default(0)
  creadoPorId        String
  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  articulo       Articulo       @relation(fields: [articuloId], references: [id])
  creadoPor      User           @relation("OrdenCreador", fields: [creadoPorId], references: [id])
  pausas         Pausa[]
  ordenPadre     OrdenTrabajo?  @relation("OrdenContinuacion", fields: [ordenPadreId], references: [id])
  continuaciones OrdenTrabajo[] @relation("OrdenContinuacion")

  @@index([estado])
  @@index([inicioProgramado])
  @@index([articuloId])
}

/// Cada vez que un operario pausa la OT en curso se crea una Pausa con motivo.
/// Al reanudar, se setea `fin`. La duración total de pausas suma al tiempo real.
model Pausa {
  id        String    @id @default(cuid())
  ordenId   String
  motivo    String
  inicio    DateTime  @default(now())
  fin       DateTime?
  createdAt DateTime  @default(now())

  orden OrdenTrabajo @relation(fields: [ordenId], references: [id], onDelete: Cascade)

  @@index([ordenId])
}

// =============================================================================
// Turnos de trabajo (configuración global)
// =============================================================================

/// Configuración de turnos de la planta. Por defecto 3 turnos (Mañana 06-14,
/// Tarde 14-22, Noche 22-06) que cubren las 24 h. Cada turno se puede
/// habilitar/deshabilitar y editar (inicio + duración en pasos de 0.5 h).
/// El inicio del primer turno habilitado = apertura de fábrica; el fin del
/// último = cierre. Las OTs deben caber dentro de la ventana de jornada
/// (turnos contiguos fusionados); si no, se ofrece partirlas.
model Turno {
  id          String   @id @default(cuid())
  /// 1 = primer turno del día, 2 = segundo, etc. Único.
  orden       Int      @unique
  /// Nombre visible del turno ("Mañana", "Tarde", "Noche").
  nombre      String   @default("Turno")
  /// Hora del día en que arranca (0-23, hora local del server).
  horaInicio  Int
  /// Minuto del día en que arranca (0-59, hora local del server).
  minutoInicio Int     @default(0)
  /// Duración en minutos.
  duracionMin Int
  habilitado  Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

/// Configuración global de la planta (singleton, id = "default").
/// Guarda el estado de "Extender turno": cuando está activo, los turnos se
/// reconfiguran a Mañana 06-12 / Tarde 12-00 (y Noche deshabilitado). Si
/// `extenderSoloUnaVez` es true, al cambiar el día calendario se restaura la
/// `configPrevia` automáticamente (revert perezoso en `obtenerTurnos`).
model ConfiguracionPlanta {
  id                 String   @id @default("default")
  extenderActivo     Boolean  @default(false)
  extenderSoloUnaVez Boolean  @default(false)
  /// Fecha (día local) en que se activó la extensión, para el revert.
  extenderFecha      DateTime?
  /// Snapshot de los turnos previos a la extensión (para restaurar).
  configPrevia       Json?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt
}

// =============================================================================
// Importación CSV (audit)
// =============================================================================

model ImportacionCsv {
  id                    String   @id @default(cuid())
  usuarioId             String
  /// Nombre original del archivo subido.
  nombreArchivo         String?
  totalFilas            Int
  filasOk               Int
  filasError            Int
  articulosNuevos       Int      @default(0)
  articulosActualizados Int      @default(0)
  articulosSinColor     Int      @default(0)
  /// JSON con detalles: errores por fila, etc.
  detalle               Json?
  createdAt             DateTime @default(now())

  usuario User @relation(fields: [usuarioId], references: [id])

  @@index([createdAt])
}
