# =============================================================================
# dao-ops — environment template
# Copiar a .env (local) o crear /opt/docker/dao-ops/.env (server) y completar.
# NUNCA commitear un .env real.
# =============================================================================

# ----- App ---------------------------------------------------------------
NODE_ENV=development
APP_URL=http://localhost:3000

# ----- Database ----------------------------------------------------------
# En docker compose local el host es `db`. Desde fuera de la red, localhost:5432.
POSTGRES_USER=daoops
POSTGRES_PASSWORD=CHANGEME
POSTGRES_DB=daoops
DATABASE_URL=postgresql://daoops:CHANGEME@db:5432/daoops?schema=public

# ----- Auth (JWT de sesion con jose) ------------------------------------
# Generar con: openssl rand -base64 32
AUTH_SECRET=CHANGEME_at_least_32_chars_long
# Duracion de la sesion en segundos (default 12h = un turno de trabajo)
SESSION_TTL_SECONDS=43200

# ----- TV (pantallas publicas sin PIN) ----------------------------------
# Token para acceder a /tv y /api/tv/*. Sin esto, el acceso a TV se deniega.
# Abrir una vez /tv?token=<valor> en el televisor (queda en cookie 1 año).
# Generar con: openssl rand -hex 24
TV_TOKEN=CHANGEME_token_largo_y_aleatorio

# ----- Seed inicial -----------------------------------------------------
# PIN inicial del admin. CAMBIAR antes del primer deploy y rotar despues.
# (No usar un PIN real en este template — el admin crea el resto de PINs.)
ADMIN_NAME=Admin
ADMIN_INITIAL_PIN=CHANGEME
